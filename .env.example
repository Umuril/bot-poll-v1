# https://discord.com/developers/applications -> your application -> Bot -> Token
DISCORD_BOT_TOKEN=

# Enable Developer Mode in Discord (User Settings -> Advanced), then
# right-click the target channel -> Copy Channel ID
DISCORD_CHANNEL_ID=

POLL_QUESTION=How are you feeling this week?
POLL_OPTIONS=Great,Okay,Not great

# Optional: one unicode emoji per option, in the same order as POLL_OPTIONS.
# Leave an entry blank to skip the emoji for that option (e.g. "😀,,😞").
# If set, must have exactly as many entries as POLL_OPTIONS.
POLL_OPTION_EMOJIS=😀,😐,😞

# Optional, defaults shown
POLL_DURATION_HOURS=24
POLL_ALLOW_MULTISELECT=false

# Optional: self-hosted Uptime Kuma push monitor URL for heartbeat monitoring.
# Create a "Push" monitor in Kuma and paste its URL here.
UPTIME_KUMA_PUSH_URL=
